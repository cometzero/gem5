# SPDX-License-Identifier: BSD-3-Clause
# Overlay on zena_css_linux.config; built-in features need no module rootfs.
CONFIG_LOCALVERSION="-gem5-zena-bench"
CONFIG_PREEMPT_LAZY=y
CONFIG_PREEMPT_RT=n
CONFIG_PREEMPT_DYNAMIC=n

# tracefs sched/IRQ/syscall events and optional latency/function tracers.
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_IRQSOFF_TRACER=y
CONFIG_PREEMPT_TRACER=y
CONFIG_SCHED_TRACER=y
CONFIG_OSNOISE_TRACER=y
CONFIG_TIMERLAT_TRACER=y
CONFIG_DEBUG_FS=y
CONFIG_SCHEDSTATS=y

# Software perf events only. The board has no PMU object, DT node or PPI.
CONFIG_PERF_EVENTS=y
CONFIG_ARM_PMU=n

# cgroup v2 CPU bandwidth, affinity and memory limits.
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_RT_GROUP_SCHED=n
CONFIG_PSI=y
CONFIG_PSI_DEFAULT_DISABLED=y

# SocketCAN software loopback; no physical CAN controller or bus timing.
CONFIG_CAN=y
CONFIG_CAN_RAW=y
CONFIG_CAN_BCM=y
CONFIG_CAN_DEV=y
CONFIG_CAN_VCAN=y
